<UserControl x:Class="MediaManager.UI.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:MediaManager.UI.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>
        <conv:FileSizeConverter x:Key="FileSize"/>
        <conv:DurationConverter x:Key="Duration"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- 空状态 -->
            <StackPanel Visibility="{Binding CurrentItem, Converter={StaticResource InvertBoolToVis}}"
                        HorizontalAlignment="Center" Margin="0,40,0,0">
                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                           HorizontalAlignment="Center" Foreground="{DynamicResource ThirdlyTextBrush}"/>
                <TextBlock Text="选择文件查看详情" FontSize="13" Margin="0,12,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource ThirdlyTextBrush}"/>
            </StackPanel>

            <!-- 详情内容 -->
            <StackPanel Visibility="{Binding CurrentItem, Converter={StaticResource BoolToVis}}">

                <!-- 预览区 -->
                <!-- 图片/视频缩略图 -->
                <Border CornerRadius="8" ClipToBounds="True" Margin="0,0,0,16"
                        Visibility="{Binding PreviewImage, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding PreviewImage}" MaxHeight="200" Stretch="Uniform"/>
                </Border>

                <!-- 音频播放器 -->
                <hc:Card Margin="0,0,0,16"
                         Visibility="{Binding IsAudio, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="12">
                        <!-- 进度条 -->
                        <Slider Value="{Binding PlaybackPosition}"
                                Maximum="{Binding PlaybackDuration}"
                                Margin="0,0,0,8"/>
                        <Grid>
                            <TextBlock HorizontalAlignment="Left" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{Binding PlaybackPosition, Converter={StaticResource Duration}}"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{Binding PlaybackDuration, Converter={StaticResource Duration}}"/>
                        </Grid>
                        <!-- 控制按钮 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Style="{StaticResource ButtonIcon}"
                                    Command="{Binding StopPlaybackCommand}" Margin="0,0,8,0">
                                <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                            </Button>
                            <Button Style="{StaticResource ButtonPrimary}" Width="48" Height="48"
                                    Command="{Binding TogglePlaybackCommand}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE768;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Text" Value="&#xE769;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </hc:Card>

                <!-- 文件名 -->
                <TextBlock Text="{Binding CurrentItem.FileName, Mode=OneWay}"
                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                <!-- 元数据 -->
                <hc:Card>
                    <StackPanel Margin="12">
                        <hc:Divider Content="文件信息" Margin="0,0,0,8"/>
                        <Grid Margin="0,4">
                            <TextBlock Text="大小" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="12"
                                       Text="{Binding CurrentItem.FileSizeFormatted, Mode=OneWay}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="时长" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="12"
                                       Text="{Binding CurrentItem.DurationFormatted, Mode=OneWay}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="分辨率" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="12"
                                       Text="{Binding CurrentItem.Resolution, Mode=OneWay}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="添加时间" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="12"
                                       Text="{Binding CurrentItem.DateAdded, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="修改时间" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="12"
                                       Text="{Binding CurrentItem.LastModified, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="路径" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="12" MaxWidth="180"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding CurrentItem.Path, Mode=OneWay}"
                                       ToolTip="{Binding CurrentItem.Path, Mode=OneWay}"/>
                        </Grid>
                    </StackPanel>
                </hc:Card>

                <!-- 哈希信息 -->
                <hc:Card Margin="0,12,0,0">
                    <StackPanel Margin="12">
                        <hc:Divider Content="哈希信息" Margin="0,0,0,8"/>
                        <Grid Margin="0,4">
                            <TextBlock Text="SHA256" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        </Grid>
                        <TextBlock Text="{Binding CurrentItem.HashFull, Mode=OneWay}" 
                                   FontFamily="Consolas" FontSize="11" 
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4"/>
                    </StackPanel>
                </hc:Card>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource ButtonPrimary}" Margin="0,0,8,0"
                            Content="重新计算" HorizontalAlignment="Stretch"
                            Command="{Binding RecalculateCommand}"/>
                    <Button Style="{StaticResource ButtonDanger}" 
                            Content="从库中移除" HorizontalAlignment="Stretch"
                            Command="{Binding DeleteFileCommand}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
