<UserControl x:Class="MediaManager.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设置" FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" MaxWidth="560" HorizontalAlignment="Left">

            <!-- 缩略图目录 -->
            <hc:Card Margin="0,0,0,16">
                <StackPanel Margin="16">
                    <hc:Divider Content="存储设置" Margin="0,0,0,12"/>
                    <TextBlock Text="缩略图目录" FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <hc:TextBox Grid.Column="0"
                                    Text="{Binding ThumbnailDirectory}"
                                    IsReadOnly="True"/>
                        <Button Grid.Column="1" Margin="8,0,0,0"
                                Content="浏览" Command="{Binding BrowseThumbnailDirectoryCommand}"/>
                    </Grid>
                </StackPanel>
            </hc:Card>

            <!-- 扫描设置 -->
            <hc:Card Margin="0,0,0,16">
                <StackPanel Margin="16">
                    <hc:Divider Content="扫描设置" Margin="0,0,0,12"/>
                    <Grid>
                        <TextBlock Text="递归扫描子目录" FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <ToggleButton HorizontalAlignment="Right"
                                      Style="{StaticResource ToggleButtonSwitch}"
                                      IsChecked="{Binding ScanRecursive}"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="缩略图尺寸（像素）" FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <hc:NumericUpDown HorizontalAlignment="Right" Width="100"
                                          Value="{Binding ThumbnailSize}"
                                          Minimum="80" Maximum="320" Increment="40"/>
                    </Grid>
                </StackPanel>
            </hc:Card>

            <!-- 保存 -->
            <Button Style="{StaticResource ButtonPrimary}"
                    Content="保存设置" HorizontalAlignment="Left"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
