<UserControl x:Class="MediaManager.UI.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:MediaManager.UI.Converters"
             xmlns:core="clr-namespace:MediaManager.Core.Enums;assembly=MediaManager.Core">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>
        
        <!-- 日志消息类型到颜色的转换器 -->
        <Style x:Key="LogMessageStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static core:LogMessageType.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static core:LogMessageType.Error}">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static core:LogMessageType.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static core:LogMessageType.StepStart}">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static core:LogMessageType.StepComplete}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static core:LogMessageType.StepFailed}">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static core:LogMessageType.Debug}">
                    <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static core:LogMessageType.Info}">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="扫描导入" FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,20"/>

        <!-- 目录选择 -->
        <hc:Card Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Margin="16">
                <TextBlock Text="扫描目录" FontSize="13" FontWeight="Medium"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <hc:TextBox Grid.Column="0"
                                Text="{Binding ScanDirectory, UpdateSourceTrigger=PropertyChanged}"
                                hc:InfoElement.Placeholder="选择或输入目录路径..."
                                IsReadOnly="True"/>
                    <Button Grid.Column="1" Margin="8,0,0,0"
                            Content="浏览" Command="{Binding BrowseDirectoryCommand}"/>
                    <Button Grid.Column="2" Margin="8,0,0,0"
                            Style="{StaticResource ButtonPrimary}"
                            Content="开始扫描"
                            Command="{Binding StartScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource InvertBoolToVis}}"/>
                    <Button Grid.Column="2" Margin="8,0,0,0"
                            Style="{StaticResource ButtonDanger}"
                            Content="取消扫描"
                            Command="{Binding CancelScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </StackPanel>
        </hc:Card>

        <!-- 扫描选项 -->
        <hc:Card Grid.Row="2" Margin="0,0,0,16">
            <StackPanel Margin="16">
                <TextBlock Text="扫描选项" FontSize="13" FontWeight="Medium"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="音频文件" IsChecked="{Binding IncludeAudio}" 
                              Margin="0,0,16,0"/>
                    <CheckBox Content="视频文件" IsChecked="{Binding IncludeVideo}"
                              Margin="0,0,16,0"/>
                    <CheckBox Content="图像文件" IsChecked="{Binding IncludeImages}"
                              Margin="0,0,16,0"/>
                    <CheckBox Content="递归扫描子目录" IsChecked="{Binding Recursive}"/>
                </StackPanel>
            </StackPanel>
        </hc:Card>

        <!-- 进度 -->
        <hc:Card Grid.Row="3" Margin="0,0,0,16">
            <StackPanel Margin="16">
                <!-- 当前步骤 -->
                <TextBlock Margin="0,0,0,8" FontSize="13"
                           Foreground="{DynamicResource PrimaryBrush}"
                           Text="{Binding Progress.StepDescription, Mode=OneWay}"/>
                
                <!-- 进度信息 -->
                <Grid Margin="0,0,0,8">
                    <TextBlock HorizontalAlignment="Left"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13">
                        <Run Text="{Binding Progress.Processed, Mode=OneWay}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding Progress.TotalDiscovered, Mode=OneWay}"/>
                        <Run Text=" 个文件"/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right"
                               Foreground="{DynamicResource PrimaryBrush}" FontSize="13"
                               Text="{Binding Progress.ProgressPercent, StringFormat={}{0:F0}%, Mode=OneWay}"/>
                </Grid>
                <ProgressBar Value="{Binding Progress.ProgressPercent, Mode=OneWay}" Maximum="100"/>
                
                <!-- 当前文件 -->
                <TextBlock Margin="0,8,0,0" FontSize="12"
                           Foreground="{DynamicResource ThirdlyTextBrush}"
                           Text="{Binding Progress.CurrentFile, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"/>
                
                <!-- 详细统计 -->
                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <WrapPanel>
                        <TextBlock Margin="0,0,16,0" FontSize="11">
                            <Run Foreground="{DynamicResource PrimaryBrush}">哈希:</Run>
                            <Run Foreground="{DynamicResource SuccessBrush}">{Binding Progress.HashSuccess}</Run>
                            <Run Text="/"/>
                            <Run Foreground="{DynamicResource DangerBrush}">{Binding Progress.HashFailed}</Run>
                        </TextBlock>
                        <TextBlock Margin="0,0,16,0" FontSize="11">
                            <Run Foreground="{DynamicResource PrimaryBrush}">元数据:</Run>
                            <Run Foreground="{DynamicResource SuccessBrush}">{Binding Progress.MetadataSuccess}</Run>
                            <Run Text="/"/>
                            <Run Foreground="{DynamicResource DangerBrush}">{Binding Progress.MetadataFailed}</Run>
                        </TextBlock>
                        <TextBlock Margin="0,0,16,0" FontSize="11">
                            <Run Foreground="{DynamicResource PrimaryBrush}">入库:</Run>
                            <Run Foreground="{DynamicResource SuccessBrush}">{Binding Progress.DatabaseSuccess}</Run>
                            <Run Text="/"/>
                            <Run Foreground="{DynamicResource DangerBrush}">{Binding Progress.DatabaseFailed}</Run>
                        </TextBlock>
                        <TextBlock Margin="0,0,16,0" FontSize="11">
                            <Run Foreground="{DynamicResource PrimaryBrush}">缩略图:</Run>
                            <Run Foreground="{DynamicResource SuccessBrush}">{Binding Progress.ThumbnailSuccess}</Run>
                            <Run Text="/"/>
                            <Run Foreground="{DynamicResource DangerBrush}">{Binding Progress.ThumbnailFailed}</Run>
                        </TextBlock>
                        <TextBlock Margin="0,0,16,0" FontSize="11">
                            <Run Foreground="{DynamicResource PrimaryBrush}">波形图:</Run>
                            <Run Foreground="{DynamicResource SuccessBrush}">{Binding Progress.WaveformSuccess}</Run>
                            <Run Text="/"/>
                            <Run Foreground="{DynamicResource DangerBrush}">{Binding Progress.WaveformFailed}</Run>
                        </TextBlock>
                        <TextBlock FontSize="11">
                            <Run Foreground="{DynamicResource PrimaryBrush}">错误:</Run>
                            <Run Foreground="{DynamicResource DangerBrush}">{Binding Progress.Errors}</Run>
                        </TextBlock>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </hc:Card>

        <!-- 日志筛选 -->
        <hc:Card Grid.Row="4" Margin="0,0,0,16">
            <StackPanel Margin="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 消息类型筛选 -->
                    <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12">消息类型:</TextBlock>
                    <ComboBox Grid.Column="1" Margin="0,0,16,0"
                              ItemsSource="{Binding AvailableMessageTypes}"
                              SelectedItem="{Binding SelectedMessageType}"
                              IsEditable="False"
                              FontSize="12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    
                    <!-- 媒体类型筛选 -->
                    <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12">媒体类型:</TextBlock>
                    <ComboBox Grid.Column="3" Margin="0,0,16,0"
                              ItemsSource="{Binding AvailableMediaTypes}"
                              SelectedItem="{Binding SelectedMediaType}"
                              IsEditable="False"
                              FontSize="12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    
                    <!-- 文件扩展名筛选 -->
                    <TextBlock Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12">扩展名:</TextBlock>
                    <ComboBox Grid.Column="5" Margin="0,0,16,0"
                              ItemsSource="{Binding DiscoveredExtensions}"
                              SelectedItem="{Binding SelectedFileExtension}"
                              IsEditable="False"
                              FontSize="12"/>
                    
                    <!-- 清除筛选按钮 -->
                    <Button Grid.Column="7" Content="清除筛选" 
                            Command="{Binding ClearFiltersCommand}"
                            FontSize="11" Padding="8,4"/>
                </Grid>
            </StackPanel>
        </hc:Card>

        <!-- 日志 -->
        <hc:Card Grid.Row="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="扫描日志" FontSize="13" FontWeight="Medium"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="16,12,16,8"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredLogView}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MinHeight="200">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource LogMessageStyle}"
                                       Text="{Binding FormattedMessage}" 
                                       FontSize="12" FontFamily="Consolas"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </hc:Card>
    </Grid>
</UserControl>
