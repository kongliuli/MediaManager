<UserControl x:Class="MediaManager.UI.Views.MediaLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:MediaManager.UI.Converters"
             xmlns:vm="clr-namespace:MediaManager.UI.ViewModels">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Padding="16,12" Background="{StaticResource NavBackground}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ButtonPrimary}" Content="新建媒体库"
                        Command="{Binding ShowAddPanelCommand}" Margin="0,0,8,0"/>
                <Button Content="刷新" Command="{Binding LoadLibrariesCommand}"/>
            </StackPanel>
        </Border>

        <!-- 添加媒体库面板 -->
        <hc:Card Grid.Row="1" Margin="16" Visibility="{Binding AddPanelVisibility}">
            <StackPanel Margin="16">
                <TextBlock Text="新建媒体库" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 名称 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,8"
                               VerticalAlignment="Center" FontSize="13">名称:</TextBlock>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding NewLibraryName}"
                             hc:InfoElement.Placeholder="输入媒体库名称"/>

                    <!-- 扫描路径 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,8"
                               VerticalAlignment="Center" FontSize="13">扫描目录:</TextBlock>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Text="{Binding NewLibraryPath}" Width="300"
                                 hc:InfoElement.Placeholder="选择扫描目录"/>
                        <Button Content="浏览..." Command="{Binding BrowsePathCommand}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- 扫描选项 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,8"
                               VerticalAlignment="Center" FontSize="13">扫描选项:</TextBlock>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Content="音频" IsChecked="{Binding NewLibraryIncludeAudio}" Margin="0,0,16,0"/>
                        <CheckBox Content="视频" IsChecked="{Binding NewLibraryIncludeVideo}" Margin="0,0,16,0"/>
                        <CheckBox Content="图像" IsChecked="{Binding NewLibraryIncludeImages}" Margin="0,0,16,0"/>
                        <CheckBox Content="递归扫描" IsChecked="{Binding NewLibraryRecursive}"/>
                    </StackPanel>

                    <!-- 按钮 -->
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Command="{Binding HideAddPanelCommand}" Margin="0,0,8,0"/>
                        <Button Content="创建" Style="{StaticResource ButtonPrimary}"
                                Command="{Binding CreateLibraryCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </hc:Card>

        <!-- 加载指示器 -->
        <hc:LoadingCircle Grid.Row="1" IsRunning="{Binding IsLoading}"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- 媒体库列表 -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Libraries}"
                 SelectedItem="{Binding SelectedLibrary}"
                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                 Margin="16">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Background="{StaticResource CardBackground}"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 基本信息 -->
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"/>
                                    <hc:Badge Content="{Binding FileCount}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ScanPath}" FontSize="12" Margin="0,4,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="状态: " FontSize="11" Foreground="{DynamicResource ThirdlyTextBrush}"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource ThirdlyTextBrush}"/>
                                    <TextBlock Text="最后扫描: " FontSize="11" Foreground="{DynamicResource ThirdlyTextBrush}"/>
                                    <TextBlock Text="{Binding LastScannedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" 
                                               FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 操作按钮 -->
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <Button Content="增量扫描" Style="{StaticResource ButtonPrimary}"
                                        Command="{Binding DataContext.StartIncrementalScanCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Margin="8,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="查看文件" 
                                            Command="{Binding DataContext.ViewLibraryFilesCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Margin="8,0,4,0"/>
                                    <Button Content="删除" Style="{StaticResource ButtonDanger}"
                                            Command="{Binding DataContext.DeleteLibraryCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 空状态 -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Libraries.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="&#xE191;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                       HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock Text="暂无媒体库" FontSize="16" Margin="0,12,0,4"
                       HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock Text="点击「新建媒体库」创建您的第一个媒体库" FontSize="13"
                       HorizontalAlignment="Center" Foreground="{DynamicResource ThirdlyTextBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
