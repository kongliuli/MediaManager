<UserControl x:Class="MediaManager.UI.Views.CacheView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:MediaManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CacheViewModel}"
             Background="#0A0A0F">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="缓存管理"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#F0F0F5"
                   Margin="0,0,0,20"/>

        <!-- 统计卡片 -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
            <!-- 缓存项数量 -->
            <Border Background="#171722"
                    BorderBrush="#00FFC8"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="缓存项数量"
                               FontSize="12"
                               Foreground="#606070"
                               TextTransform="Uppercase"/>
                    <TextBlock Text="{Binding ItemCount, StringFormat={}{0:N0}}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#00FFC8"/>
                </StackPanel>
            </Border>

            <!-- 内存使用 -->
            <Border Background="#171722"
                    BorderBrush="#FF006E"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="15"
                    Margin="10,0,10,0">
                <StackPanel>
                    <TextBlock Text="内存使用"
                               FontSize="12"
                               Foreground="#606070"
                               TextTransform="Uppercase"/>
                    <TextBlock Text="{Binding MemoryUsageMB, StringFormat={}{0:F2} MB}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#FF006E"/>
                </StackPanel>
            </Border>

            <!-- 命中次数 -->
            <Border Background="#171722"
                    BorderBrush="#8338EC"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="15"
                    Margin="10,0,10,0">
                <StackPanel>
                    <TextBlock Text="命中次数"
                               FontSize="12"
                               Foreground="#606070"
                               TextTransform="Uppercase"/>
                    <TextBlock Text="{Binding HitCount, StringFormat={}{0:N0}}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#8338EC"/>
                </StackPanel>
            </Border>

            <!-- 命中率 -->
            <Border Background="#171722"
                    BorderBrush="#FF9F00"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="15"
                    Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="命中率"
                               FontSize="12"
                               Foreground="#606070"
                               TextTransform="Uppercase"/>
                    <TextBlock Text="{Binding HitRate, StringFormat={}{0:F1}%}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#FF9F00"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">
            <Button Content="🔄 刷新统计"
                    Command="{Binding RefreshCommand}"
                    Background="#1E1E2E"
                    Foreground="#F0F0F5"
                    BorderBrush="#00FFC8"
                    BorderThickness="1"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
            
            <Button Content="🗑️ 清空缓存"
                    Command="{Binding ClearCacheCommand}"
                    Background="#FF006E"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="20,10"
                    Margin="10,0,0,0"
                    Cursor="Hand"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
        </StackPanel>

        <!-- 状态消息 -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   FontSize="12"
                   Foreground="#606070"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"/>
    </Grid>
</UserControl>
