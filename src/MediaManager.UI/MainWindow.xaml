<hc:Window x:Class="MediaManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:vm="clr-namespace:MediaManager.UI.ViewModels"
        xmlns:views="clr-namespace:MediaManager.UI.Views"
        xmlns:conv="clr-namespace:MediaManager.UI.Converters"
        Title="MediaManager" Height="760" Width="1360" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        NonClientAreaBackground="{DynamicResource RegionBrush}">

    <hc:Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <!-- DataTemplate 路由：ContentControl 根据 ViewModel 类型自动选择 View -->
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MediaLibraryViewModel}">
            <views:MediaLibraryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <views:ScanView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaylistViewModel}">
            <views:PlaylistView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DuplicateViewModel}">
            <views:DuplicateView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CacheViewModel}">
            <views:CacheView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PerformanceViewModel}">
            <views:PerformanceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </hc:Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ── 左侧导航栏 ── -->
        <Border Grid.Column="0" Background="{StaticResource NavBackground}">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Padding="20,20,20,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="22" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="MediaManager" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Separator DockPanel.Dock="Top" Background="{StaticResource SeparatorBrush}" Margin="0,0,0,8"/>

                <!-- 导航按钮 -->
                <StackPanel DockPanel.Dock="Top" Margin="8,0" HorizontalAlignment="Stretch">
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateLibraryCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="媒体文件"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateMediaLibraryCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE191;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="媒体库管理"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateScanCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="扫描导入"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateSearchCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="搜索"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigatePlaylistCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE90B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="播放列表"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateDuplicateCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="重复文件"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCacheCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE8B8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="缓存管理"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigatePerformanceCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE7B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="性能监控"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 底部设置 -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButtonStyle}"
                        Margin="8,0,8,12"
                        Command="{Binding NavigateSettingsCommand}"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                        <TextBlock Text="设置"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- ── 中间内容区 ── -->
        <Border Grid.Column="1" Background="{StaticResource ContentBackground}">
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </Border>

        <!-- ── 右侧详情面板 ── -->
        <Border Grid.Column="2" Width="320"
                Background="{StaticResource DetailBackground}"
                Visibility="{Binding IsDetailPanelVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <!-- 关闭按钮 -->
                <Button DockPanel.Dock="Top" HorizontalAlignment="Right"
                        Style="{StaticResource ButtonIcon}"
                        Margin="0,8,8,0"
                        Command="{Binding CloseDetailCommand}">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <views:DetailView DataContext="{Binding DetailViewModel}"/>
            </DockPanel>
        </Border>
    </Grid>
</hc:Window>
