<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol">

    <!-- 导航侧边栏背景 -->
    <SolidColorBrush x:Key="NavBackground" Color="#1E1E2E"/>
    <!-- 内容区背景 -->
    <SolidColorBrush x:Key="ContentBackground" Color="#181825"/>
    <!-- 详情面板背景 -->
    <SolidColorBrush x:Key="DetailBackground" Color="#1E1E2E"/>
    <!-- 卡片背景 -->
    <SolidColorBrush x:Key="CardBackground" Color="#2A2A3E"/>
    <!-- 分隔线颜色 -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#313145"/>

    <!-- 全局字体 -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- 媒体卡片样式 -->
    <Style x:Key="MediaCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3A3A5E"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 导航按钮样式 -->
    <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
        <Setter Property="Height" Value="44"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2A2A3E"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 进度条样式 -->
    <Style TargetType="ProgressBar" BasedOn="{StaticResource ProgressBarBaseStyle}">
        <Setter Property="Height" Value="6"/>
        <Setter Property="hc:BorderElement.CornerRadius" Value="3"/>
    </Style>

</ResourceDictionary>
