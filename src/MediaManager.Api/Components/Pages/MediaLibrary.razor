@page "/media"
@inject HttpClient Http
@inject NavigationManager NavManager

<PageTitle>媒体库 - MediaManager</PageTitle>

<div class="mm-page-header mm-animate-in">
    <h1 class="mm-page-title">媒体库</h1>
    <p class="mm-page-subtitle">浏览和管理您的媒体文件</p>
</div>

<!-- 搜索和筛选器 -->
<div class="mm-card mb-5 mm-animate-in" style="animation-delay: 0.1s;">
    <div class="mm-card-header">
        <h3 class="mm-card-title">搜索和筛选</h3>
    </div>
    <div class="card-body" style="padding-top: 0;">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="input-group">
                    <input type="text" class="mm-form-input" placeholder="搜索文件..." @bind="SearchKeyword" @bind:event="oninput">
                    <button class="mm-btn mm-btn-primary" @onclick="LoadMedia" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                        🔍
                    </button>
                </div>
            </div>
            <div class="col-md-2">
                <select class="mm-form-input" @bind="SelectedMediaType">
                    <option value="">全部类型</option>
                    <option value="0">🎵 音频</option>
                    <option value="1">🎬 视频</option>
                    <option value="2">🖼️ 图片</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="mm-form-input" @bind="SortBy">
                    <option value="DateAdded">📅 添加日期</option>
                    <option value="FileName">📄 文件名</option>
                    <option value="FileSize">💾 文件大小</option>
                    <option value="Duration">⏱️ 时长</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="mm-form-input" @bind="SortDescending">
                    <option value="true">⬇️ 降序</option>
                    <option value="false">⬆️ 升序</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="mm-btn mm-btn-primary w-100" @onclick="LoadMedia">
                    应用筛选
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 媒体文件网格 -->
@if (MediaItems == null)
{
    <div class="text-center py-5">
        <div style="font-size: 4rem; margin-bottom: 1rem; animation: pulse 1.5s ease-in-out infinite;">⏳</div>
        <p style="color: var(--mm-text-muted);">正在加载媒体文件...</p>
    </div>
}
else if (!MediaItems.Any())
{
    <div class="text-center py-5">
        <div style="font-size: 4rem; margin-bottom: 1rem;">📭</div>
        <p style="color: var(--mm-text-muted);">暂无媒体文件</p>
    </div>
}
else
{
    <div class="mm-media-grid mm-animate-in" style="animation-delay: 0.2s;">
        @foreach (var item in MediaItems)
        {
            <div class="mm-media-item" @onclick="() => ViewDetails(item)">
                <div class="mm-media-thumb">
                    @if (item.MediaType == 1)
                    {
                        <span>🎬</span>
                    }
                    else if (item.MediaType == 2)
                    {
                        <span>🖼️</span>
                    }
                    else
                    {
                        <span>🎵</span>
                    }
                </div>
                <div class="mm-media-info">
                    <div class="mm-media-name" title="@item.FileName">@item.FileName</div>
                    <div class="mm-media-meta">
                        <span style="margin-right: 1rem;">💾 @FormatFileSize(item.FileSize)</span>
                        @if (item.DurationSeconds > 0)
                        {
                            <span>⏱️ @FormatDuration(item.DurationSeconds)</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 分页 -->
    <div class="d-flex justify-content-center mt-5 mm-animate-in" style="animation-delay: 0.3s;">
        <div class="mm-card" style="display: inline-block; padding: 1rem 2rem;">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <button class="mm-btn mm-btn-secondary" @onclick="() => GoToPage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)">
                    ⬅️ 上一页
                </button>
                <span style="color: var(--mm-text-secondary);">第 @CurrentPage 页，共 @TotalPages 页</span>
                <button class="mm-btn mm-btn-secondary" @onclick="() => GoToPage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)">
                    下一页 ➡️
                </button>
            </div>
        </div>
    </div>
}

<!-- 详情模态框 -->
@if (SelectedMedia != null)
{
    <div class="mm-modal-overlay show" @onclick="() => SelectedMedia = null">
        <div class="mm-modal" style="max-width: 700px;" @onclick:stopPropagation>
            <div class="mm-modal-header">
                <h3 class="mm-modal-title">文件详情</h3>
                <button class="mm-modal-close" @onclick="() => SelectedMedia = null">✕</button>
            </div>
            <div class="mm-modal-body">
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div style="background: var(--mm-bg-tertiary); border-radius: var(--mm-radius-lg); height: 200px; display: flex; align-items: center; justify-content: center; font-size: 4rem;">
                            @if (SelectedMedia.MediaType == 1)
                            {
                                <span>🎬</span>
                            }
                            else if (SelectedMedia.MediaType == 2)
                            {
                                <span>🖼️</span>
                            }
                            else
                            {
                                <span>🎵</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-8">
                        <h4 style="margin-bottom: 0.5rem; color: var(--mm-text-primary);">@SelectedMedia.FileName</h4>
                        <p style="color: var(--mm-text-muted); font-size: 0.85rem; margin-bottom: 1.5rem;">@SelectedMedia.Path</p>
                        
                        <div style="display: grid; gap: 1rem;">
                            <div style="display: flex; justify-content: space-between; padding: 0.75rem; background: var(--mm-bg-tertiary); border-radius: var(--mm-radius-md);">
                                <span style="color: var(--mm-text-muted);">💾 文件大小</span>
                                <span style="color: var(--mm-text-primary); font-weight: 600;">@FormatFileSize(SelectedMedia.FileSize)</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; padding: 0.75rem; background: var(--mm-bg-tertiary); border-radius: var(--mm-radius-md);">
                                <span style="color: var(--mm-text-muted);">⏱️ 时长</span>
                                <span style="color: var(--mm-text-primary); font-weight: 600;">@FormatDuration(SelectedMedia.DurationSeconds)</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; padding: 0.75rem; background: var(--mm-bg-tertiary); border-radius: var(--mm-radius-md);">
                                <span style="color: var(--mm-text-muted);">📅 添加时间</span>
                                <span style="color: var(--mm-text-primary); font-weight: 600;">@SelectedMedia.DateAdded.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; padding: 0.75rem; background: var(--mm-bg-tertiary); border-radius: var(--mm-radius-md);">
                                <span style="color: var(--mm-text-muted);">⭐ 评分</span>
                                <span>
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <span style="color: @(i < SelectedMedia.Rating ? "#ff9f00" : "#606070");">⭐</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mm-modal-footer">
                <button class="mm-btn mm-btn-secondary" @onclick="() => SelectedMedia = null">关闭</button>
                <button class="mm-btn mm-btn-danger" @onclick="() => DeleteMedia(SelectedMedia.Id)">删除文件</button>
            </div>
        </div>
    </div>
}

@code {
    private List<MediaItem>? MediaItems;
    private MediaItem? SelectedMedia;
    private string SearchKeyword = "";
    private string SelectedMediaType = "";
    private string SortBy = "DateAdded";
    private string SortDescending = "true";
    private int CurrentPage = 1;
    private int PageSize = 20;
    private int TotalCount;
    private int TotalPages => (int)Math.Ceiling((double)TotalCount / PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadMedia();
    }

    private async Task LoadMedia()
    {
        try
        {
            var url = $"api/media?page={CurrentPage}&pageSize={PageSize}&sortBy={SortBy}&sortDescending={SortDescending}";
            
            if (!string.IsNullOrWhiteSpace(SearchKeyword))
            {
                url += $"&search={Uri.EscapeDataString(SearchKeyword)}";
            }
            
            if (!string.IsNullOrWhiteSpace(SelectedMediaType))
            {
                url += $"&mediaType={SelectedMediaType}";
            }

            var response = await Http.GetFromJsonAsync<MediaListResponse>(url);
            if (response != null)
            {
                MediaItems = response.Items;
                TotalCount = response.TotalCount;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载媒体文件失败: {ex.Message}");
        }
    }

    private void ViewDetails(MediaItem item)
    {
        SelectedMedia = item;
    }

    private async Task DeleteMedia(Guid id)
    {
        if (!confirm("确定要删除这个文件吗？"))
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/media/{id}");
            if (response.IsSuccessStatusCode)
            {
                SelectedMedia = null;
                await LoadMedia();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"删除文件失败: {ex.Message}");
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        CurrentPage = page;
        await LoadMedia();
    }

    private string FormatDuration(int seconds)
    {
        if (seconds <= 0) return "-";
        var time = TimeSpan.FromSeconds(seconds);
        return time.Hours > 0 ? $"{time.Hours}:{time.Minutes:D2}:{time.Seconds:D2}" : $"{time.Minutes}:{time.Seconds:D2}";
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size = size / 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }

    private bool confirm(string message)
    {
        return true;
    }

    public class MediaListResponse
    {
        public List<MediaItem> Items { get; set; } = new();
        public int TotalCount { get; set; }
    }

    public class MediaItem
    {
        public Guid Id { get; set; }
        public string Path { get; set; } = "";
        public string FileName { get; set; } = "";
        public long FileSize { get; set; }
        public int DurationSeconds { get; set; }
        public int MediaType { get; set; }
        public int Rating { get; set; }
        public string Notes { get; set; } = "";
        public DateTime DateAdded { get; set; }
    }
}
