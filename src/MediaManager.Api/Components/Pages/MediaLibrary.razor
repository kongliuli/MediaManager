@page "/media"
@inject HttpClient Http
@inject NavigationManager NavManager

<PageTitle>媒体库 - MediaManager</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>媒体库</h1>
        <div>
            <div class="input-group" style="width: 300px;">
                <input type="text" class="form-control" placeholder="搜索文件..." @bind="SearchKeyword" @bind:event="oninput">
                <button class="btn btn-outline-secondary" @onclick="LoadMedia">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- 筛选器 -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <select class="form-select" @bind="SelectedMediaType">
                        <option value="">全部类型</option>
                        <option value="0">音频</option>
                        <option value="1">视频</option>
                        <option value="2">图片</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="SortBy">
                        <option value="DateAdded">添加日期</option>
                        <option value="FileName">文件名</option>
                        <option value="FileSize">文件大小</option>
                        <option value="Duration">时长</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="SortDescending">
                        <option value="true">降序</option>
                        <option value="false">升序</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary w-100" @onclick="LoadMedia">
                        <i class="bi bi-funnel me-2"></i>应用筛选
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 媒体文件网格 -->
    @if (MediaItems == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">加载中...</span>
            </div>
            <p class="mt-3">正在加载媒体文件...</p>
        </div>
    }
    else if (!MediaItems.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-folder-x display-1 text-muted"></i>
            <p class="mt-3 text-muted">暂无媒体文件</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in MediaItems)
            {
                <div class="col">
                    <div class="card h-100 media-card">
                        <div class="card-img-top bg-dark d-flex align-items-center justify-content-center" style="height: 200px;">
                            @if (item.MediaType == 1)
                            {
                                <i class="bi bi-film text-white display-3"></i>
                            }
                            else if (item.MediaType == 2)
                            {
                                <i class="bi bi-image text-white display-3"></i>
                            }
                            else
                            {
                                <i class="bi bi-music-note-beamed text-white display-3"></i>
                            }
                        </div>
                        <div class="card-body">
                            <h6 class="card-title text-truncate" title="@item.FileName">@item.FileName</h6>
                            <p class="card-text small text-muted">
                                <i class="bi bi-folder me-1"></i>@Path.GetFileName(Path.GetDirectoryName(item.Path))
                            </p>
                            <p class="card-text small">
                                @if (item.DurationSeconds > 0)
                                {
                                    <span class="badge bg-info me-1">@FormatDuration(item.DurationSeconds)</span>
                                }
                                <span class="badge bg-secondary">@FormatFileSize(item.FileSize)</span>
                            </p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="btn-group w-100" role="group">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewDetails(item)">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteMedia(item.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- 分页 -->
        <div class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination">
                    <li class="page-item @(CurrentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)">上一页</button>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">第 @CurrentPage 页，共 @TotalPages 页</span>
                    </li>
                    <li class="page-item @(CurrentPage >= TotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)">下一页</button>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<!-- 详情模态框 -->
@if (SelectedMedia != null)
{
    <div class="modal" style="display: block; background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">文件详情</h5>
                    <button type="button" class="btn-close" @onclick="() => SelectedMedia = null"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="bg-dark d-flex align-items-center justify-content-center rounded" style="height: 200px;">
                                @if (SelectedMedia.MediaType == 1)
                                {
                                    <i class="bi bi-film text-white display-3"></i>
                                }
                                else if (SelectedMedia.MediaType == 2)
                                {
                                    <i class="bi bi-image text-white display-3"></i>
                                }
                                else
                                {
                                    <i class="bi bi-music-note-beamed text-white display-3"></i>
                                }
                            </div>
                        </div>
                        <div class="col-md-8">
                            <h5>@SelectedMedia.FileName</h5>
                            <p class="text-muted small">@SelectedMedia.Path</p>
                            <dl class="row">
                                <dt class="col-sm-4">文件大小</dt>
                                <dd class="col-sm-8">@FormatFileSize(SelectedMedia.FileSize)</dd>
                                
                                <dt class="col-sm-4">时长</dt>
                                <dd class="col-sm-8">@FormatDuration(SelectedMedia.DurationSeconds)</dd>
                                
                                <dt class="col-sm-4">添加时间</dt>
                                <dd class="col-sm-8">@SelectedMedia.DateAdded.ToString("yyyy-MM-dd HH:mm")</dd>
                                
                                <dt class="col-sm-4">评分</dt>
                                <dd class="col-sm-8">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <i class="bi @(i < SelectedMedia.Rating ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => SelectedMedia = null">关闭</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MediaItem>? MediaItems;
    private MediaItem? SelectedMedia;
    private string SearchKeyword = "";
    private string SelectedMediaType = "";
    private string SortBy = "DateAdded";
    private string SortDescending = "true";
    private int CurrentPage = 1;
    private int PageSize = 20;
    private int TotalCount;
    private int TotalPages => (int)Math.Ceiling((double)TotalCount / PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadMedia();
    }

    private async Task LoadMedia()
    {
        try
        {
            var url = $"api/media?page={CurrentPage}&pageSize={PageSize}&sortBy={SortBy}&sortDescending={SortDescending}";
            
            if (!string.IsNullOrWhiteSpace(SearchKeyword))
            {
                url += $"&search={Uri.EscapeDataString(SearchKeyword)}";
            }
            
            if (!string.IsNullOrWhiteSpace(SelectedMediaType))
            {
                url += $"&mediaType={SelectedMediaType}";
            }

            var response = await Http.GetFromJsonAsync<MediaListResponse>(url);
            if (response != null)
            {
                MediaItems = response.Items;
                TotalCount = response.TotalCount;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载媒体文件失败: {ex.Message}");
        }
    }

    private void ViewDetails(MediaItem item)
    {
        SelectedMedia = item;
    }

    private async Task DeleteMedia(Guid id)
    {
        if (!confirm("确定要删除这个文件吗？"))
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/media/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadMedia();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"删除文件失败: {ex.Message}");
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        CurrentPage = page;
        await LoadMedia();
    }

    private string FormatDuration(int seconds)
    {
        if (seconds <= 0) return "-";
        var time = TimeSpan.FromSeconds(seconds);
        return time.Hours > 0 ? $"{time.Hours}:{time.Minutes:D2}:{time.Seconds:D2}" : $"{time.Minutes}:{time.Seconds:D2}";
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size = size / 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }

    private bool confirm(string message)
    {
        return true;
    }

    public class MediaListResponse
    {
        public List<MediaItem> Items { get; set; } = new();
        public int TotalCount { get; set; }
    }

    public class MediaItem
    {
        public Guid Id { get; set; }
        public string Path { get; set; } = "";
        public string FileName { get; set; } = "";
        public long FileSize { get; set; }
        public int DurationSeconds { get; set; }
        public int MediaType { get; set; }
        public int Rating { get; set; }
        public string Notes { get; set; } = "";
        public DateTime DateAdded { get; set; }
    }
}
