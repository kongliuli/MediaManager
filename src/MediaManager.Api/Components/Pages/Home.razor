@page "/"
@inject HttpClient Http
@inject NavigationManager NavManager
@implements IAsyncDisposable

<PageTitle>MediaManager - 智能媒体管理</PageTitle>

<div class="mm-page-header mm-animate-in">
    <h1 class="mm-page-title">欢迎回来</h1>
    <p class="mm-page-subtitle">管理您的媒体文件，发现精彩内容</p>
</div>

<!-- 统计卡片区域 -->
<div class="row mb-5">
    <div class="col-md-3 mb-4 mm-animate-in mm-animate-delay-1">
        <div class="mm-stat-card mm-stat-card--primary">
            <div class="mm-stat-label">总文件数</div>
            <div class="mm-stat-value">@Stats?.TotalCount ?? 0</div>
            <div class="mm-stat-sub">@Stats?.TotalSizeFormatted</div>
        </div>
    </div>
    <div class="col-md-3 mb-4 mm-animate-in mm-animate-delay-2">
        <div class="mm-stat-card mm-stat-card--audio">
            <div class="mm-stat-label">音频文件</div>
            <div class="mm-stat-value">@Stats?.AudioCount ?? 0</div>
            <div class="mm-stat-sub">音乐、播客等</div>
        </div>
    </div>
    <div class="col-md-3 mb-4 mm-animate-in mm-animate-delay-3">
        <div class="mm-stat-card mm-stat-card--video">
            <div class="mm-stat-label">视频文件</div>
            <div class="mm-stat-value">@Stats?.VideoCount ?? 0</div>
            <div class="mm-stat-sub">影片、视频等</div>
        </div>
    </div>
    <div class="col-md-3 mb-4 mm-animate-in mm-animate-delay-4">
        <div class="mm-stat-card mm-stat-card--image">
            <div class="mm-stat-label">图片文件</div>
            <div class="mm-stat-value">@Stats?.ImageCount ?? 0</div>
            <div class="mm-stat-sub">照片、图像等</div>
        </div>
    </div>
</div>

<!-- 快捷操作区域 -->
<div class="mm-card mb-5 mm-animate-in" style="animation-delay: 0.3s;">
    <div class="mm-card-header">
        <h3 class="mm-card-title">快捷操作</h3>
    </div>
    <div class="card-body" style="padding-top: 0;">
        <div class="row g-4">
            <div class="col-md-4">
                <button class="mm-btn mm-btn-primary w-100" @onclick="ShowScanModal">
                    <span class="mm-btn-icon">🔍</span>
                    开始新扫描
                </button>
            </div>
            <div class="col-md-4">
                <button class="mm-btn mm-btn-secondary w-100" @onclick="() => NavManager.NavigateTo("/media")">
                    <span class="mm-btn-icon">📂</span>
                    浏览媒体库
                </button>
            </div>
            <div class="col-md-4">
                <button class="mm-btn mm-btn-secondary w-100" @onclick="() => NavManager.NavigateTo("/duplicates")">
                    <span class="mm-btn-icon">🔄</span>
                    查找重复文件
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 最近扫描任务 -->
<div class="mm-card mm-animate-in" style="animation-delay: 0.4s;">
    <div class="mm-card-header">
        <h3 class="mm-card-title">最近扫描任务</h3>
        <button class="mm-btn mm-btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.85rem;" @onclick="LoadTasks">
            🔄 刷新
        </button>
    </div>
    <div class="card-body" style="padding-top: 0;">
        @if (Tasks == null || !Tasks.Any())
        {
            <div class="text-center py-5">
                <div style="font-size: 3rem; margin-bottom: 1rem;">📭</div>
                <p style="color: var(--mm-text-muted); margin: 0;">暂无扫描任务</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="mm-table">
                    <thead>
                        <tr>
                            <th>任务ID</th>
                            <th>路径</th>
                            <th>状态</th>
                            <th>进度</th>
                            <th>创建时间</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Tasks.Take(5))
                        {
                            <tr>
                                <td>
                                    <code style="background: var(--mm-bg-tertiary); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.85rem;">
                                        @task.Id.Substring(0, 8)...
                                    </code>
                                </td>
                                <td>@task.LibraryPath</td>
                                <td>
                                    <span class="mm-badge @GetStatusBadgeClass(task.Status)">
                                        @task.Status
                                    </span>
                                </td>
                                <td style="min-width: 150px;">
                                    @if (task.TotalCount > 0)
                                    {
                                        <div class="mm-progress mb-2">
                                            <div class="mm-progress-bar" style="width: @((double)task.ProcessedCount / task.TotalCount * 100)%"></div>
                                        </div>
                                        <small style="color: var(--mm-text-muted);">@task.ProcessedCount / @task.TotalCount</small>
                                    }
                                    else
                                    {
                                        <span style="color: var(--mm-text-muted);">等待中...</span>
                                    }
                                </td>
                                <td>@task.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @if (task.Status == "Running")
                                    {
                                        <button class="mm-btn mm-btn-danger" style="padding: 0.4rem 0.8rem; font-size: 0.8rem;" @onclick="() => CancelTask(task.Id)">
                                            ✕
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- 扫描模态框 -->
<div class="mm-modal-overlay @(ShowScan ? "show" : "")" @onclick="CloseScanModal">
    <div class="mm-modal" @onclick:stopPropagation>
        <div class="mm-modal-header">
            <h3 class="mm-modal-title">开始新扫描</h3>
            <button class="mm-modal-close" @onclick="CloseScanModal">✕</button>
        </div>
        <div class="mm-modal-body">
            <div class="mb-4">
                <label class="mm-form-label">目录路径</label>
                <input type="text" class="mm-form-input" @bind="ScanPath" placeholder="例如: C:\Media" />
            </div>
            <div class="mm-form-check">
                <input type="checkbox" class="mm-form-check-input" id="recursive" @bind="Recursive">
                <label for="recursive" style="color: var(--mm-text-secondary);">递归扫描子目录</label>
            </div>
        </div>
        <div class="mm-modal-footer">
            <button class="mm-btn mm-btn-secondary" @onclick="CloseScanModal">取消</button>
            <button class="mm-btn mm-btn-primary" @onclick="StartScan">开始扫描</button>
        </div>
    </div>
</div>

@code {
    private MediaStats? Stats;
    private List<ScanTask>? Tasks;
    private string ScanPath = "";
    private bool Recursive = true;
    private bool ShowScan = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
        await LoadTasks();
    }

    private async Task LoadStats()
    {
        try
        {
            Stats = await Http.GetFromJsonAsync<MediaStats>("api/media/stats");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载统计信息失败: {ex.Message}");
        }
    }

    private async Task LoadTasks()
    {
        try
        {
            Tasks = await Http.GetFromJsonAsync<List<ScanTask>>("api/scan/tasks");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载任务失败: {ex.Message}");
        }
    }

    private void ShowScanModal()
    {
        ShowScan = true;
    }

    private void CloseScanModal()
    {
        ShowScan = false;
    }

    private async Task StartScan()
    {
        if (string.IsNullOrWhiteSpace(ScanPath))
        {
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/scan/start", new { LibraryPath = ScanPath, Recursive = Recursive });
            if (response.IsSuccessStatusCode)
            {
                CloseScanModal();
                await LoadTasks();
                await LoadStats();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"启动扫描失败: {ex.Message}");
        }
    }

    private async Task CancelTask(string taskId)
    {
        try
        {
            await Http.PostAsync($"api/scan/tasks/{taskId}/cancel", null);
            await LoadTasks();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"取消任务失败: {ex.Message}");
        }
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "mm-badge-info",
        "Running" => "mm-badge-info",
        "Completed" => "mm-badge-success",
        "Failed" => "mm-badge-danger",
        "Cancelled" => "mm-badge-warning",
        _ => "mm-badge-info"
    };

    public ValueTask DisposeAsync()
    {
        return ValueTask.CompletedTask;
    }

    public class MediaStats
    {
        public int TotalCount { get; set; }
        public int AudioCount { get; set; }
        public int VideoCount { get; set; }
        public int ImageCount { get; set; }
        public long TotalSize { get; set; }
        public string TotalSizeFormatted { get; set; } = "";
    }

    public class ScanTask
    {
        public string Id { get; set; } = "";
        public string LibraryPath { get; set; } = "";
        public bool Recursive { get; set; }
        public string Status { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public int ProcessedCount { get; set; }
        public int TotalCount { get; set; }
    }
}
