@page "/"
@inject HttpClient Http
@inject NavigationManager NavManager
@implements IAsyncDisposable

<PageTitle>首页 - MediaManager</PageTitle>

<div class="container-fluid">
    <h1 class="mb-4">欢迎使用 MediaManager</h1>

    <!-- 统计卡片 -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card stat-card total-card">
                <div class="card-body">
                    <h5 class="card-title">总文件数</h5>
                    <h2 class="card-text">@Stats?.TotalCount ?? 0</h2>
                    <p class="card-text"><small class="text-muted">@Stats?.TotalSizeFormatted</small></p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card stat-card audio-card">
                <div class="card-body">
                    <h5 class="card-title">音频文件</h5>
                    <h2 class="card-text text-primary">@Stats?.AudioCount ?? 0</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card stat-card video-card">
                <div class="card-body">
                    <h5 class="card-title">视频文件</h5>
                    <h2 class="card-text text-danger">@Stats?.VideoCount ?? 0</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card stat-card image-card">
                <div class="card-body">
                    <h5 class="card-title">图片文件</h5>
                    <h2 class="card-text text-success">@Stats?.ImageCount ?? 0</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- 快捷操作 -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">快捷操作</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <button class="btn btn-primary w-100" onclick="document.getElementById('scanModal').classList.add('show');">
                        <i class="bi bi-plus-circle me-2"></i>开始新扫描
                    </button>
                </div>
                <div class="col-md-4 mb-3">
                    <button class="btn btn-secondary w-100" @onclick="() => NavManager.NavigateTo("/media")">
                        <i class="bi bi-folder-open me-2"></i>浏览媒体库
                    </button>
                </div>
                <div class="col-md-4 mb-3">
                    <button class="btn btn-info w-100 text-white" @onclick="() => NavManager.NavigateTo("/duplicates")">
                        <i class="bi bi-search me-2"></i>查找重复文件
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 最近扫描任务 -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">最近扫描任务</h5>
            <button class="btn btn-sm btn-outline-primary" @onclick="LoadTasks">
                <i class="bi bi-arrow-clockwise"></i> 刷新
            </button>
        </div>
        <div class="card-body">
            @if (Tasks == null || !Tasks.Any())
            {
                <p class="text-muted text-center">暂无扫描任务</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>任务ID</th>
                                <th>路径</th>
                                <th>状态</th>
                                <th>进度</th>
                                <th>创建时间</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in Tasks.Take(5))
                            {
                                <tr>
                                    <td><code>@task.Id.Substring(0, 8)...</code></td>
                                    <td>@task.LibraryPath</td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(task.Status)">
                                            @task.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (task.TotalCount > 0)
                                        {
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar" style="width: @((double)task.ProcessedCount / task.TotalCount * 100)%"></div>
                                            </div>
                                            <small>@task.ProcessedCount / @task.TotalCount</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">等待中...</span>
                                        }
                                    </td>
                                    <td>@task.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        @if (task.Status == "Running")
                                        {
                                            <button class="btn btn-sm btn-danger" @onclick="() => CancelTask(task.Id)">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- 扫描模态框 -->
<div class="modal" id="scanModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">开始新扫描</h5>
                <button type="button" class="btn-close" onclick="document.getElementById('scanModal').classList.remove('show');"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="libraryPath" class="form-label">目录路径</label>
                    <input type="text" class="form-control" id="libraryPath" @bind="ScanPath" placeholder="例如: C:\Media">
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="recursive" @bind="Recursive">
                    <label class="form-check-label" for="recursive">
                        递归扫描子目录
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('scanModal').classList.remove('show');">取消</button>
                <button type="button" class="btn btn-primary" @onclick="StartScan">开始扫描</button>
            </div>
        </div>
    </div>
</div>

@code {
    private MediaStats? Stats;
    private List<ScanTask>? Tasks;
    private string ScanPath = "";
    private bool Recursive = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
        await LoadTasks();
    }

    private async Task LoadStats()
    {
        try
        {
            Stats = await Http.GetFromJsonAsync<MediaStats>("api/media/stats");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载统计信息失败: {ex.Message}");
        }
    }

    private async Task LoadTasks()
    {
        try
        {
            Tasks = await Http.GetFromJsonAsync<List<ScanTask>>("api/scan/tasks");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载任务失败: {ex.Message}");
        }
    }

    private async Task StartScan()
    {
        if (string.IsNullOrWhiteSpace(ScanPath))
        {
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/scan/start", new { LibraryPath = ScanPath, Recursive = Recursive });
            if (response.IsSuccessStatusCode)
            {
                document.getElementById('scanModal').classList.remove('show');
                await LoadTasks();
                await LoadStats();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"启动扫描失败: {ex.Message}");
        }
    }

    private async Task CancelTask(string taskId)
    {
        try
        {
            await Http.PostAsync($"api/scan/tasks/{taskId}/cancel", null);
            await LoadTasks();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"取消任务失败: {ex.Message}");
        }
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-secondary",
        "Running" => "bg-primary",
        "Completed" => "bg-success",
        "Failed" => "bg-danger",
        "Cancelled" => "bg-warning",
        _ => "bg-secondary"
    };

    public ValueTask DisposeAsync()
    {
        return ValueTask.CompletedTask;
    }

    public class MediaStats
    {
        public int TotalCount { get; set; }
        public int AudioCount { get; set; }
        public int VideoCount { get; set; }
        public int ImageCount { get; set; }
        public long TotalSize { get; set; }
        public string TotalSizeFormatted { get; set; } = "";
    }

    public class ScanTask
    {
        public string Id { get; set; } = "";
        public string LibraryPath { get; set; } = "";
        public bool Recursive { get; set; }
        public string Status { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public int ProcessedCount { get; set; }
        public int TotalCount { get; set; }
    }
}
