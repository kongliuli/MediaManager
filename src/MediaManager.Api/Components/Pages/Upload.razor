@page "/upload"
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime? JS

<PageTitle>上传管理 - MediaManager</PageTitle>

<div class="mm-page-header mm-animate-in">
    <h1 class="mm-page-title">上传管理</h1>
    <p class="mm-page-subtitle">上传和管理您的媒体文件</p>
</div>

<!-- 上传状态 -->
<div class="mm-card mb-5 mm-animate-in" style="animation-delay: 0.1s;">
    <div class="mm-card-header">
        <h3 class="mm-card-title">上传设置</h3>
        <button class="mm-btn mm-btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.85rem;" @onclick="LoadUploadStatus">
            🔄 刷新状态
        </button>
    </div>
    <div style="padding: 0 1.5rem 1.5rem;">
        <div class="row">
            <div class="col-md-6">
                <div style="display: grid; gap: 1rem;">
                    <div style="display: flex; justify-content: space-between; padding: 1rem; background: var(--mm-bg-tertiary); border-radius: var(--mm-radius-md);">
                        <span style="color: var(--mm-text-muted);">存储方式</span>
                        @if (UploadStatus?.OssEnabled == true)
                        {
                            <span class="mm-badge mm-badge-success">阿里云 OSS</span>
                        }
                        else
                        {
                            <span class="mm-badge mm-badge-info">本地存储</span>
                        }
                    </div>
                    <div style="display: flex; justify-content: space-between; padding: 1rem; background: var(--mm-bg-tertiary); border-radius: var(--mm-radius-md);">
                        <span style="color: var(--mm-text-muted);">最大文件大小</span>
                        <span style="color: var(--mm-text-primary); font-weight: 600;">@UploadStatus?.MaxFileSizeFormatted</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding: 1rem; background: var(--mm-bg-tertiary); border-radius: var(--mm-radius-md);">
                        <span style="color: var(--mm-text-muted);">支持格式</span>
                        <span style="color: var(--mm-text-primary); font-weight: 600;">@string.Join(", ", UploadStatus?.AllowedExtensions ?? Array.Empty<string>())</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 上传区域 -->
<div class="mm-card mb-5 mm-animate-in" style="animation-delay: 0.2s;">
    <div class="mm-card-header">
        <h3 class="mm-card-title">上传文件</h3>
    </div>
    <div style="padding: 0 1.5rem 1.5rem;">
        <div class="mm-upload-area @(_isDragging ? "drag-over" : "")"
             @ondragenter="HandleDragEnter"
             @ondragleave="HandleDragLeave"
             @ondrop="HandleDrop">
            <div class="mm-upload-icon">☁️</div>
            <h4 style="color: var(--mm-text-primary); margin-bottom: 0.5rem;">拖拽文件到此处上传</h4>
            <p style="color: var(--mm-text-muted); margin-bottom: 1.5rem;">或</p>
            <InputFile OnChange="HandleFileSelect" multiple accept="@string.Join(",", UploadStatus?.AllowedExtensions ?? Array.Empty<string>())" style="display: none;" />
            <button class="mm-btn mm-btn-primary" @onclick="() => document.querySelector('input[type=\"file\"]').click()" disabled="@IsUploading">
                @if (IsUploading)
                {
                    <span style="display: flex; align-items: center; gap: 0.5rem;">
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>上传中...</span>
                    </span>
                }
                else
                {
                    <span>选择文件</span>
                }
            </button>
        </div>

        <!-- 上传进度 -->
        @if (IsUploading)
        {
            <div style="margin-top: 2rem;">
                <div class="mm-progress">
                    <div class="mm-progress-bar" style="width: @UploadProgress%;">
                        @UploadProgress%
                    </div>
                </div>
                <p style="color: var(--mm-text-muted); margin-top: 1rem;">正在上传 @CurrentFileName...</p>
            </div>
        }

        <!-- 上传结果 -->
        @if (UploadResults.Any())
        {
            <div style="margin-top: 2rem;">
                <h5 style="color: var(--mm-text-primary); margin-bottom: 1rem;">上传结果</h5>
                <div style="background: var(--mm-bg-tertiary); border-radius: var(--mm-radius-md); padding: 1rem; margin-bottom: 1.5rem; color: var(--mm-text-primary);">
                    <span style="color: var(--mm-accent-primary);">成功: @SuccessCount</span>
                    <span style="margin: 0 0.5rem;">|</span>
                    <span style="color: var(--mm-accent-secondary);">失败: @FailedCount</span>
                </div>

                <div style="overflow-x: auto;">
                    <table class="mm-table">
                        <thead>
                            <tr>
                                <th>文件名</th>
                                <th>大小</th>
                                <th>存储位置</th>
                                <th>状态</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in UploadResults)
                            {
                                <tr>
                                    <td>@result.FileName</td>
                                    <td>@FormatFileSize(result.FileSize)</td>
                                    <td>@result.Storage</td>
                                    <td>
                                        @if (result.Success)
                                        {
                                            <span class="mm-badge mm-badge-success">成功</span>
                                        }
                                        else
                                        {
                                            <span class="mm-badge mm-badge-danger">失败</span>
                                        }
                                    </td>
                                    <td>
                                        @if (result.Success)
                                        {
                                            <div style="display: flex; gap: 0.5rem;">
                                                <button class="mm-btn mm-btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem;" @onclick="() => PreviewFile(result)">
                                                    👁️
                                                </button>
                                                <button class="mm-btn mm-btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem;" @onclick="() => CopyUrl(result.Url)">
                                                    🔗
                                                </button>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- 错误列表 -->
        @if (UploadErrors.Any())
        {
            <div style="margin-top: 2rem; background: rgba(255, 0, 110, 0.1); border: 1px solid rgba(255, 0, 110, 0.3); border-radius: var(--mm-radius-md); padding: 1.5rem;">
                <h5 style="color: var(--mm-accent-secondary); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                    <span>⚠️</span>
                    <span>错误</span>
                </h5>
                <ul style="color: var(--mm-text-primary); margin: 0; padding-left: 1.5rem;">
                    @foreach (var error in UploadErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

<!-- 最近上传 -->
<div class="mm-card mm-animate-in" style="animation-delay: 0.3s;">
    <div class="mm-card-header">
        <h3 class="mm-card-title">最近上传</h3>
        <button class="mm-btn mm-btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.85rem;" @onclick="LoadRecentUploads">
            🔄 刷新
        </button>
    </div>
    <div style="padding: 0 1.5rem 1.5rem;">
        @if (RecentUploads == null || !RecentUploads.Any())
        {
            <div class="text-center py-5">
                <div style="font-size: 3rem; margin-bottom: 1rem;">📭</div>
                <p style="color: var(--mm-text-muted); margin: 0;">暂无上传记录</p>
            </div>
        }
        else
        {
            <div style="overflow-x: auto;">
                <table class="mm-table">
                    <thead>
                        <tr>
                            <th>文件名</th>
                            <th>大小</th>
                            <th>存储位置</th>
                            <th>上传时间</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var upload in RecentUploads)
                        {
                            <tr>
                                <td>@upload.FileName</td>
                                <td>@FormatFileSize(upload.FileSize)</td>
                                <td>@upload.Storage</td>
                                <td>@upload.UploadedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <button class="mm-btn mm-btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem;" @onclick="() => PreviewFile(upload)">
                                            👁️
                                        </button>
                                        <button class="mm-btn mm-btn-danger" style="padding: 0.4rem 0.8rem; font-size: 0.8rem;" @onclick="() => DeleteFile(upload)">
                                            🗑️
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- 预览组件 -->
<FilePreview @ref="PreviewComponent" />

@code {
    private UploadStatusInfo? UploadStatus;
    private List<UploadResult> UploadResults = new();
    private List<string> UploadErrors = new();
    private List<RecentUpload> RecentUploads = new();
    private bool IsUploading = false;
    private int UploadProgress = 0;
    private string CurrentFileName = "";
    private int SuccessCount = 0;
    private int FailedCount = 0;
    private bool _isDragging = false;
    private FilePreview? PreviewComponent;

    protected override async Task OnInitializedAsync()
    {
        await LoadUploadStatus();
        await LoadRecentUploads();
    }

    private async Task LoadUploadStatus()
    {
        try
        {
            UploadStatus = await Http.GetFromJsonAsync<UploadStatusInfo>("api/upload/status");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载上传状态失败: {ex.Message}");
        }
    }

    private async Task LoadRecentUploads()
    {
        try
        {
            await Task.Delay(100);
            RecentUploads = new List<RecentUpload>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载最近上传失败: {ex.Message}");
        }
    }

    private void HandleDragEnter()
    {
        _isDragging = true;
    }

    private void HandleDragLeave()
    {
        _isDragging = false;
    }

    private async Task HandleDrop(DragEventArgs e)
    {
        _isDragging = false;
        
        if (e.DataTransfer?.Files != null)
        {
            await UploadFiles(e.DataTransfer.Files);
        }
    }

    private async Task HandleFileSelect(InputFileChangeEventArgs e)
    {
        await UploadFiles(e.GetMultipleFiles());
    }

    private async Task UploadFiles(IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count == 0) return;

        IsUploading = true;
        UploadResults.Clear();
        UploadErrors.Clear();
        SuccessCount = 0;
        FailedCount = 0;

        var form = new MultipartFormDataContent();
        
        for (int i = 0; i < files.Count; i++)
        {
            var file = files[i];
            CurrentFileName = file.Name;
            UploadProgress = (int)((i + 0.5) / files.Count * 100);
            StateHasChanged();

            try
            {
                var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024));
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
                form.Add(fileContent, "file", file.Name);

                var response = await Http.PostAsync("api/upload", form);
                
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<UploadResult>();
                    if (result != null)
                    {
                        UploadResults.Add(result);
                        if (result.Success)
                        {
                            SuccessCount++;
                        }
                        else
                        {
                            FailedCount++;
                            UploadErrors.Add(result.FileName + ": 上传失败");
                        }
                    }
                }
                else
                {
                    FailedCount++;
                    UploadErrors.Add($"{file.Name}: HTTP {response.StatusCode}");
                }
            }
            catch (Exception ex)
            {
                FailedCount++;
                UploadErrors.Add($"{file.Name}: {ex.Message}");
            }

            form = new MultipartFormDataContent();
        }

        UploadProgress = 100;
        IsUploading = false;
        CurrentFileName = "";
        StateHasChanged();

        await LoadRecentUploads();
    }

    private void PreviewFile(UploadResult result)
    {
        PreviewComponent?.Show();
    }

    private void PreviewFile(RecentUpload upload)
    {
        PreviewComponent?.Show();
    }

    private void CopyUrl(string url)
    {
        Console.WriteLine($"URL: {url}");
    }

    private async Task DeleteFile(RecentUpload upload)
    {
        if (JS != null && !await JS.InvokeAsync<bool>("confirm", $"确定要删除 {upload.FileName} 吗？"))
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/upload/{upload.FilePath}");
            if (response.IsSuccessStatusCode)
            {
                await LoadRecentUploads();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"删除失败: {ex.Message}");
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size = size / 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }

    public class UploadStatusInfo
    {
        public bool OssEnabled { get; set; }
        public long MaxFileSize { get; set; }
        public string MaxFileSizeFormatted { get; set; } = "";
        public string[] AllowedExtensions { get; set; } = Array.Empty<string>();
    }

    public class UploadResult
    {
        public bool Success { get; set; }
        public string FileName { get; set; } = "";
        public long FileSize { get; set; }
        public string ContentType { get; set; } = "";
        public string Url { get; set; } = "";
        public string Storage { get; set; } = "";
    }

    public class RecentUpload
    {
        public string FileName { get; set; } = "";
        public string FilePath { get; set; } = "";
        public long FileSize { get; set; }
        public string Storage { get; set; } = "";
        public DateTime UploadedAt { get; set; }
    }
}
