@page "/duplicates"
@inject HttpClient Http
@inject NavigationManager NavManager

<PageTitle>重复文件 - MediaManager</PageTitle>

<div class="container-fluid">
    <h1 class="mb-4">重复文件</h1>

    @if (DuplicateGroups == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">加载中...</span>
            </div>
            <p class="mt-3">正在查找重复文件...</p>
        </div>
    }
    else if (!DuplicateGroups.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-check-circle display-1 text-success"></i>
            <p class="mt-3 text-muted">没有发现重复文件！</p>
        </div>
    }
    else
    {
        @foreach (var group in DuplicateGroups)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-files me-2"></i>
                        @group.Files.FirstOrDefault()?.FileName
                        @group.Files.FirstOrDefault()?.FileName.Split('.').LastOrDefault()
                        文件 (可回收: @FormatFileSize(group.ReclaimableSize)
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var file in group.Files)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="flex-grow-1 me-3">
                                    <h6 class="mb-1">@file.FileName</h6>
                                    <p class="mb-0 text-muted small">@file.Path</p>
                                    <small class="text-muted">
                                        @FormatFileSize(file.FileSize) · 添加于 @file.DateAdded.ToString("yyyy-MM-dd")</small>
                                    </p>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-danger" @onclick="() => KeepFile(file)">
                                        <i class="bi bi-check-circle me-1"></i>保留
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteFile(file.Id)">
                                        <i class="bi bi-trash me-1"></i>删除
                                    </button>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<DuplicateGroup>? DuplicateGroups;
    private bool IsLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDuplicates();
    }

    private async Task LoadDuplicates()
    {
        try
        {
            IsLoading = true;
            await Task.Delay(500);
            DuplicateGroups = new List<DuplicateGroup>();
            IsLoading = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"查找重复文件失败: {ex.Message}");
            IsLoading = false;
        }
    }

    private void KeepFile(MediaItem item)
    {
        var group = DuplicateGroups?.FirstOrDefault(g => g.Files.Any(f => f.Id == item.Id));
        if (group != null)
        {
            // 只是简单地标记，不改变顺序
        }
    }

    private async Task DeleteFile(Guid id)
    {
        if (!confirm("确定要删除这个文件吗？"))
        {
            return;
        }
        try
        {
            var response = await Http.DeleteAsync($"api/media/{id}");
            if (response.IsSuccessStatusCode && DuplicateGroups != null)
            {
                var group = DuplicateGroups.FirstOrDefault(g => g.Files.Any(f => f.Id == id));
                if (group != null)
                {
                    group.Files.RemoveAll(f => f.Id == id);
                    if (group.Files.Count < 2)
                    {
                        DuplicateGroups.Remove(group);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"删除文件失败: {ex.Message}");
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size = size / 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }

    private bool confirm(string message) => true;

    public class DuplicateGroup
    {
        public List<MediaItem> Files { get; set; } = new();
        public long ReclaimableSize => Files.Skip(1).Sum(f => f.FileSize);
    }

    public class MediaItem
    {
        public Guid Id { get; set; }
        public string Path { get; set; } = "";
        public string FileName { get; set; } = "";
        public long FileSize { get; set; }
        public DateTime DateAdded { get; set; }
    }
}
