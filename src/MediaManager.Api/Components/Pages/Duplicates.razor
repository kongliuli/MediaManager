@page "/duplicates"
@inject HttpClient Http
@inject NavigationManager NavManager

<PageTitle>重复文件 - MediaManager</PageTitle>

<div class="mm-page-header mm-animate-in">
    <h1 class="mm-page-title">重复文件</h1>
    <p class="mm-page-subtitle">查找并处理重复的媒体文件</p>
</div>

@if (DuplicateGroups == null)
{
    <div class="text-center py-5 mm-animate-in" style="animation-delay: 0.1s;">
        <div style="font-size: 3rem; margin-bottom: 1rem; animation: pulse 1.5s ease-in-out infinite;">⏳</div>
        <p style="color: var(--mm-text-muted);">正在查找重复文件...</p>
    </div>
}
else if (!DuplicateGroups.Any())
{
    <div class="text-center py-5 mm-animate-in" style="animation-delay: 0.1s;">
        <div style="font-size: 4rem; margin-bottom: 1rem; color: var(--mm-accent-primary);">✅</div>
        <p style="color: var(--mm-text-muted);">没有发现重复文件！</p>
    </div>
}
else
{
    int delay = 1;
    foreach (var group in DuplicateGroups)
    {
        <div class="mm-card mb-5 mm-animate-in" style="animation-delay: @(delay * 0.1) s;">
            <div class="mm-card-header">
                <h3 class="mm-card-title">
                    📄 @group.Files.FirstOrDefault()?.FileName 
                    (@group.Files.Count 份, 可回收: @FormatFileSize(group.ReclaimableSize))
                </h3>
            </div>
            <div style="padding: 0 1.5rem 1.5rem;">
                <div style="display: grid; gap: 1rem;">
                    @foreach (var file in group.Files)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: var(--mm-bg-tertiary); border-radius: var(--mm-radius-md); gap: 1.5rem;">
                            <div style="flex-grow: 1; min-width: 0;">
                                <div style="font-weight: 600; color: var(--mm-text-primary); margin-bottom: 0.25rem;">@file.FileName</div>
                                <div style="font-size: 0.85rem; color: var(--mm-text-muted); margin-bottom: 0.25rem;">@file.Path</div>
                                <div style="font-size: 0.8rem; color: var(--mm-text-muted);">
                                    📦 @FormatFileSize(file.FileSize) · 📅 @file.DateAdded.ToString("yyyy-MM-dd")
                                </div>
                            </div>
                            <div style="display: flex; gap: 0.5rem;">
                                <button class="mm-btn mm-btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem;" @onclick="() => KeepFile(file)">
                                    ✅ 保留
                                </button>
                                <button class="mm-btn mm-btn-danger" style="padding: 0.4rem 0.8rem; font-size: 0.8rem;" @onclick="() => DeleteFile(file.Id)">
                                    🗑️ 删除
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        delay++;
    }
}

@code {
    private List<DuplicateGroup>? DuplicateGroups;
    private bool IsLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDuplicates();
    }

    private async Task LoadDuplicates()
    {
        try
        {
            IsLoading = true;
            await Task.Delay(500);
            DuplicateGroups = new List<DuplicateGroup>();
            IsLoading = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"查找重复文件失败: {ex.Message}");
            IsLoading = false;
        }
    }

    private void KeepFile(MediaItem item)
    {
        var group = DuplicateGroups?.FirstOrDefault(g => g.Files.Any(f => f.Id == item.Id));
        if (group != null)
        {
            // 只是简单地标记，不改变顺序
        }
    }

    private async Task DeleteFile(Guid id)
    {
        if (!confirm("确定要删除这个文件吗？"))
        {
            return;
        }
        try
        {
            var response = await Http.DeleteAsync($"api/media/{id}");
            if (response.IsSuccessStatusCode && DuplicateGroups != null)
            {
                var group = DuplicateGroups.FirstOrDefault(g => g.Files.Any(f => f.Id == id));
                if (group != null)
                {
                    group.Files.RemoveAll(f => f.Id == id);
                    if (group.Files.Count < 2)
                    {
                        DuplicateGroups.Remove(group);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"删除文件失败: {ex.Message}");
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size = size / 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }

    private bool confirm(string message) => true;

    public class DuplicateGroup
    {
        public List<MediaItem> Files { get; set; } = new();
        public long ReclaimableSize => Files.Skip(1).Sum(f => f.FileSize);
    }

    public class MediaItem
    {
        public Guid Id { get; set; }
        public string Path { get; set; } = "";
        public string FileName { get; set; } = "";
        public long FileSize { get; set; }
        public DateTime DateAdded { get; set; }
    }
}
